rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Operational data: the app creates, edits and cleans these up
    match /{col}/{docId} {
      allow read, write: if col in [
        'dailyTasks', 'weeklyTemplates', 'system', 'users',
        'shiftCoverRules', 'taskScheduleLifecycles', 'complianceRecords',
        'hotFoodBatches', 'hotFoodChecks', 'hotFoodProducts',
        'hotFoodDayState', 'hotFoodConfig', 'hotFoodSignoffs',
        'hotFoodSessions'
      ];
    }

    // Audit trail and completion ledger: can be added to and updated, never deleted
    match /{col}/{docId} {
      allow read, create, update: if col in [
        'taskManagerAudit', 'hotFoodAudit', 'auditEvents',
        'taskCompletionLedger'
      ];
    }

    // Anything not listed above is denied by default
  }
}
